# Narrato runs with no configuration at all.
#
# Kokoro (the default voice engine) runs on-device and needs no key, no account
# and no server. Everything below is OPTIONAL and only enables the premium
# cloud-voice engine.
#
# There is intentionally no API key here. This is a static site, so any key in
# the bundle would be readable by every visitor. Instead, point Narrato at a
# relay that YOU host, and keep the key on the relay.
# See "Premium voices" in README.md for a minimal relay.

# elevenlabs | openai | none
VITE_TTS_PROVIDER=none

# Your relay endpoint. Receives { text, voice, provider, speed } and must
# respond with raw audio bytes (audio/mpeg or audio/wav).
VITE_TTS_PROXY_URL=
